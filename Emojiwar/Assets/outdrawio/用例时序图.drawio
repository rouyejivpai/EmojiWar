        <mxCell id="msgf2" value="FireWeapon(target)" style="endArrow=open;endFill=0;dashed=0;html=1;exitX=1;exitY=0.22;entryX=0;entryY=0.22;" parent="1f" source="lifelineLine-PCFire" target="lifelineLine-EntityFire" edge="1">
