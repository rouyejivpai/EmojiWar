          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="msgf6" value="bulletRb.velocity = dir * speed" style="endArrow=open;endFill=0;dashed=0;html=1;exitX=1;exitY=0.58;entryX=0;entryY=0.58;" parent="1f" source="lifelineLine-Weapon" target="lifelineLine-Projectile" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="msgf7" value="PlayOneShot(fireSound)" style="endArrow=open;endFill=0;dashed=0;html=1;exitX=1;exitY=0.66;entryX=0;entryY=0.66;" parent="1f" source="lifelineLine-Weapon" target="lifelineLine-Weapon" edge="1">
