        <mxCell id="msgf8" value="return true" style="endArrow=open;endFill=0;dashed=1;html=1;exitX=0;exitY=0.74;entryX=1;entryY=0.74;" parent="1f" source="lifelineLine-Weapon" target="lifelineLine-EntityFire" edge="1">
