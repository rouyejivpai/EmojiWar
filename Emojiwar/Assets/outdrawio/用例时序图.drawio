  <diagram name="控制角色移动" id="seq-move">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title-move" value="控制角色移动时序图" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="420" y="20" width="330" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="lifeline-PlayerInput" value="PlayerInput" style="swimlane;fontStyle=1;align=center;verticalAlign=top;startSize=26;" parent="1" vertex="1">
          <mxGeometry x="60" y="60" width="160" height="680" as="geometry"/>
        </mxCell>
        <mxCell id="lifelineLine-PlayerInput" value="" style="line;strokeWidth=2;" parent="lifeline-PlayerInput" vertex="1">
          <mxGeometry x="80" y="40" width="2" height="620" as="geometry"/>
        </mxCell>

        <mxCell id="lifeline-PlayerController" value="PlayerController" style="swimlane;fontStyle=1;align=center;verticalAlign=top;startSize=26;" parent="1" vertex="1">
          <mxGeometry x="280" y="60" width="180" height="680" as="geometry"/>
        </mxCell>
        <mxCell id="lifelineLine-PlayerController" value="" style="line;strokeWidth=2;" parent="lifeline-PlayerController" vertex="1">
          <mxGeometry x="90" y="40" width="2" height="620" as="geometry"/>
        </mxCell>

        <mxCell id="lifeline-Entity" value="Entity" style="swimlane;fontStyle=1;align=center;verticalAlign=top;startSize=26;" parent="1" vertex="1">
          <mxGeometry x="520" y="60" width="160" height="680" as="geometry"/>
        </mxCell>
        <mxCell id="lifelineLine-Entity" value="" style="line;strokeWidth=2;" parent="lifeline-Entity" vertex="1">
          <mxGeometry x="80" y="40" width="2" height="620" as="geometry"/>
        </mxCell>

        <mxCell id="lifeline-Rigidbody2D" value="Rigidbody2D" style="swimlane;fontStyle=1;align=center;verticalAlign=top;startSize=26;" parent="1" vertex="1">
          <mxGeometry x="740" y="60" width="180" height="680" as="geometry"/>
        </mxCell>
        <mxCell id="lifelineLine-Rigidbody2D" value="" style="line;strokeWidth=2;" parent="lifeline-Rigidbody2D" vertex="1">
          <mxGeometry x="90" y="40" width="2" height="620" as="geometry"/>
        </mxCell>

        <mxCell id="msg1" value="Update(): 读取输入轴" style="endArrow=open;endFill=0;dashed=0;html=1;exitX=1;exitY=0.12;entryX=0;entryY=0.12;" parent="1" source="lifelineLine-PlayerInput" target="lifelineLine-PlayerController" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="msg2" value="Move(direction)" style="endArrow=open;endFill=0;dashed=0;html=1;exitX=1;exitY=0.24;entryX=0;entryY=0.24;" parent="1" source="lifelineLine-PlayerController" target="lifelineLine-Entity" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="msg3" value="FixedUpdate() → UpdatePosition()" style="endArrow=open;endFill=0;dashed=0;html=1;exitX=1;exitY=0.36;entryX=0;entryY=0.36;" parent="1" source="lifelineLine-Entity" target="lifelineLine-Rigidbody2D" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="msg4" value="rb.velocity = direction * moveSpeed" style="endArrow=open;endFill=0;dashed=0;html=1;exitX=1;exitY=0.42;entryX=0;entryY=0.42;" parent="1" source="lifelineLine-Rigidbody2D" target="lifelineLine-Rigidbody2D" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

