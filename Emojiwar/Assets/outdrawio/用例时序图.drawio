        <mxCell id="msgf1" value="HandleShootInput()" style="endArrow=open;endFill=0;dashed=0;html=1;exitX=1;exitY=0.12;entryX=0;entryY=0.12;" parent="1f" source="lifelineLine-InputFire" target="lifelineLine-PCFire" edge="1">
